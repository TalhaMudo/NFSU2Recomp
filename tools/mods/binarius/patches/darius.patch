+        /// <summary>
+        /// Local macOS change: the game uploads at most 8 mip levels of a texture (the
+        /// most any of its own has; Carbon 4K's CARBONFIBRE brings 13, and levels 9-13
+        /// were never filled).  A .dds with more keeps its 8 largest.  The layout is told
+        /// from the size: DXT1 (8-byte blocks), DXT3/5 (16), or 4, 2, 1 bytes a pixel;
+        /// a size that fits none is left as it is.
+        /// </summary>
+        private void CapMipmaps()
+        {
+            const int max = 8;
+            if (this.Mipmaps <= max || this.PaletteSize != 0) return;
+            long Total(int levels, int block, int bpp)
+            {
+                long t = 0;
+                for (int i = 0; i < levels; ++i)
+                {
+                    int w = Math.Max(1, this.Width >> i), h = Math.Max(1, this.Height >> i);
+                    t += block > 0 ? (long)Math.Max(1, (w + 3) / 4) * Math.Max(1, (h + 3) / 4) * block : (long)w * h * bpp;
+                }
+                return t;
+            }
+            foreach (var (block, bpp) in new[] { (8, 0), (16, 0), (0, 4), (0, 2), (0, 1) })
+            {
+                if (Total(this.Mipmaps, block, bpp) != this.Data.Length) continue;
+                var keep = (int)Total(max, block, bpp);
+                var data = new byte[keep];
+                Array.Copy(this.Data, data, keep);
+                this.Data = data;
+                this.Size = keep;
+                this.Mipmaps = max;
+                return;
+            }
+        }
+
         /// <summary>
         /// Reads .dds data from the <see cref="TPKBlock"/>.
         /// </summary>
